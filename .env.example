# Copy to .env and adjust as needed. See docs/Docker.md#environment-configuration.
# Never commit a real .env file; these are placeholder values only.

# Database
POSTGRES_USER=openqms
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openqms
DATABASE_URL=postgresql+asyncpg://openqms:changeme@db:5432/openqms

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# Authentication (Milestone 1) - see docs/DecisionLog.md.
# JWT_SECRET_KEY has no safe default; the backend refuses to start without one.
# Generate a real value yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap admin (Milestone 1) - creates the first admin user on first startup only,
# per docs/Database.md and the Milestone 1 plan. Leave BOOTSTRAP_ADMIN_PASSWORD empty
# to have a random password generated and logged once (see `docker compose logs backend`).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# File storage (Milestone 2) - the openqms_uploads volume is mounted here in the
# backend container. See docs/Database.md#documents-and-related-tables-milestone-2.
UPLOADS_DIR=/app/uploads

# Frontend
VITE_API_BASE_URL=http://localhost:8000
